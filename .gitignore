# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Cargo.lock is deliberately tracked: hyprsnap is a binary, and the release
# tarball must pin the exact dependency graph that was built and tested.
# https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Coverage report
lcov.info
*.lcov

# Mise
!/mise.toml
!/mise.lock
mise.*.toml
.mise.*.toml
